{
  "name": "MathProblem",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "counting",
        "addition",
        "subtraction",
        "multiplication",
        "division",
        "shapes"
      ],
      "description": "Type of math problem"
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Difficulty level"
    },
    "question_text": {
      "type": "string",
      "description": "The text question, keep minimal"
    },
    "visual_type": {
      "type": "string",
      "enum": [
        "apples",
        "stars",
        "blocks",
        "numbers"
      ],
      "default": "blocks"
    },
    "number_1": {
      "type": "integer"
    },
    "number_2": {
      "type": "integer"
    },
    "answer": {
      "type": "integer"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Breakdown steps for Step-Chain mode"
    }
  },
  "required": [
    "type",
    "answer"
  ]
}